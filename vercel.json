{
  "buildCommand": "pip install -r requirements.txt",
  "framework": "flask",
  "python": {
    "version": "3.12"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
