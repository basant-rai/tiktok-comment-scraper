# Flask Configuration
DEBUG=False
HOST=127.0.0.1
PORT=5000

# Scraper Configuration
# msToken cookie from tiktok.com (DevTools > Application > Cookies) - helps avoid bot detection
MS_TOKEN=
HEADLESS=True
MAX_COMMENTS=500
TIMEOUT=60
RETRIES=3
SLEEP_AFTER=2

# Output & Logging
OUTPUT_DIR=exports
LOGS_DIR=logs

# Request Configuration
REQUEST_TIMEOUT=30
MAX_VIDEOS_BATCH=10
